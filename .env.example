# Copy to .env.local and fill in real IDs before deploying.
# Never commit real analytics IDs — this file only documents the shape.

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Recipient for lead-form submissions (app/api/contact/route.ts).
# Falls back to lib/constants.ts SITE.email if unset.
CONTACT_EMAIL=jevgenij@nyvexo.lv

# SMTP credentials for the mailbox that actually sends lead notifications
# (app/api/contact/route.ts, via nodemailer). Get these from wherever
# jevgenij@nyvexo.lv's mail is hosted (domain registrar / mail provider
# control panel -> SMTP / mail client settings). All four are required —
# without them the contact form cannot deliver mail in production.
# Set in Vercel under Project Settings -> Environment Variables, Production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=jevgenij@nyvexo.lv
SMTP_PASSWORD=
